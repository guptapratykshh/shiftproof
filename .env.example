SHIFTPROOF_ENV=local
SHIFTPROOF_DATA_DIR=.local
EXTRACTION_PROVIDER=scripted
GNANI_API_KEY=
# Leave scripted active until: python scripts/check_gemini.py succeeds.
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.8-flash
# Confirm this key belongs to an unbilled/free-tier project in Google AI Studio.
GEMINI_FREE_TIER_CONFIRMED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_NOTES_PER_DAY=100
MAX_MODEL_CALLS_PER_DAY=200
# Cloud values are injected by infra/template.yaml.
# GNANI_SECRET_ARN=
# TABLE_NAME=
# AUDIO_BUCKET=
# QUEUE_URL=
# COGNITO_POOL_ID=
# COGNITO_CLIENT_ID=

# Organization accounts (local SQLite; AWS remains paused)
# Total model/speech budget remains MAX_MODEL_CALLS_PER_DAY.
MAX_ORGANIZATION_CALLS_PER_DAY=50
# Set true for an HTTPS reverse proxy that does not forward the original scheme.
COOKIE_SECURE=false
# Optional absolute SQLite path shared by private/public processes for provider limits.
SHIFTPROOF_SHARED_USAGE_DB=

# Persistent-host pilot (opt in; run separate worker when enabled)
SHIFTPROOF_DURABLE_JOBS=false
# WAL is rejected on unpatched SQLite. Pilot container pins 3.51.3.
SHIFTPROOF_SQLITE_WAL=false
PILOT_SIGNUP_APPROVAL_REQUIRED=false
PILOT_APPROVED_OWNER_EMAILS=
MAX_DEMO_CALLS_PER_DAY=40
MAX_PRIVATE_CALLS_PER_DAY=160
# Real-data processing must use explicitly approved business credentials.
SHIFTPROOF_BUSINESS_PROVIDER_APPROVED=false
GEMINI_ACCOUNT_TIER=free
GEMINI_BUSINESS_TERMS_CONFIRMED=false
GEMINI_BUSINESS_API_KEY=
GEMINI_BUSINESS_MODEL_ID=
GNANI_ACCOUNT_TIER=programme
GNANI_BUSINESS_TERMS_CONFIRMED=false
GNANI_BUSINESS_API_KEY=
